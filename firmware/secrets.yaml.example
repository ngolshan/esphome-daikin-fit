---
# Copy to secrets.yaml (or add these keys to the ESPHome add-on's shared
# secrets.yaml at /config/esphome/secrets.yaml) and fill in.
#
# Generate the API key with:  openssl rand -base64 32
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"
fallback_wifi_password: "fallback-ap-password"
daikin_bus_monitor_api_key: "base64-32-byte-key-here"
daikin_bus_monitor_ota_password: "ota-password-here"
